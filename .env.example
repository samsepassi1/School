# API keys for the moderation system
GEMINI_API_KEY=your-google-gemini-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Authentication for FastAPI backend
USER_API_KEY=local-dev-secret

# Optional model overrides
MODERATION_MODEL=gemini-2.0-flash
CUSTOMER_MODEL=gemini-2.0-flash

# Phoenix / OpenTelemetry
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=multimodal-moderation
